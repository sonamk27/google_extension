# Copy this file to .env and fill in as needed.

PORT=5000

# Set to true to run without any API key - returns a deterministic simulated
# action so you can demo/test the full pipeline offline. Set to false and
# provide ANTHROPIC_API_KEY to actually call a live VLM.
MOCK_MODE=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Shared secret between Chrome extension and backend server for endpoint protection
EXTENSION_SHARED_SECRET=dev-secret-key-visual-privacy-agent-2026

# Optional: lock down CORS to your Chrome extension ID e.g. chrome-extension://<id>
CORS_ORIGIN=*
